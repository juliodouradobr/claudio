{
  "expo": {
    "name": "Rotina Pro",
    "slug": "rotina-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1115",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#0F1115" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.rotinapro.app" },
    "android": {
      "package": "com.rotinapro.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["VIBRATE", "POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM"]
    },
    "plugins": [
      ["expo-notifications", { "color": "#FF6B1A" }]
    ],
    "web": { "favicon": "./assets/favicon.png" }
  }
}
